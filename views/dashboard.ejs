<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Controle de Gastos</title>
    <link rel="stylesheet" href="/css/inapp.css">
    <link rel="stylesheet" href="/css/modal.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

<div class="sidebar">
    <div class="user">Olá, <%= (typeof userName !== 'undefined') ? userName : '...' %></div>
    <h2>💰 Finanças</h2>

    <button name="createFolder" class="addFolder" onclick="openModal('folders')">Criar pasta</button>
    <button name="insertCard" onclick="openModal('cards')">Cadastrar cartões</button>
    <button name="insertbuy" onclick="openModal('phFolders')" >Inserir compra</button>
    <button name="installment" onclick="openModal('installments')">Parcelados</button>
    <button name="excludeFolder" onclick="openModal('exFolders')">Excluir pasta</button>
    <button name="configFolder">Configurar pasta</button>
</div>

<div class="main">

<div class="header">
    <h1>Seus Gastos</h1>

    <select class="toggle">
        <option value="1">Janeiro</option>
        <option value="2">Fevereiro</option>
        <option value="3">Março</option>
        <option value="4" selected>Abril</option>
    </select>
</div>

<div class="top-controls">
    <select id="folderToggle" class="toggle">
        <option value="all">Tudo</option>
        <% if (typeof pastas !== 'undefined' && pastas.length > 0) { %>
            <% pastas.forEach(pasta => { %>
                <option value="<%= pasta.id %>"><%= pasta.name %></option>
            <% }) %>
        <% } %>
    </select>

    <input type="text" class="search-input" placeholder="Pesquisar...">
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Produto</th>
                <th>Valor</th>
                <th>Data</th>
                <th>Cartão</th>
                <th>Pasta</th>
                <th>Parcelas</th> </tr>
        </thead>
      <tbody>
            <% if (typeof itens !== 'undefined' && itens.length > 0) { %>
                <% itens.forEach(gasto => { %>
                    <tr>
                        <td><%= gasto.description %></td>
                        
                        <td>R$ <%= Number(gasto.valor_parcela_calculado).toFixed(2).replace('.', ',') %></td>
                        
                        <td><%= new Date(gasto.purchase_date).toLocaleDateString('pt-BR', {timeZone: 'UTC'}) %></td> 
                        
                        <td><%= gasto.card_name ? gasto.card_name : 'Dinheiro / Pix' %></td>
                        
                        <td><%= gasto.folder_name ? gasto.folder_name : 'Geral' %></td>
                        
                        <td><%= gasto.current_installment || 1 %>/<%= gasto.total_installment || 1 %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" style="text-align: center; color: #888;">
                        Nenhum registro encontrado.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<div class="total">
    Total de contas: R$ <%= typeof totalDoMes !== 'undefined' ? Number(totalDoMes).toFixed(2).replace('.', ',') : '0,00' %>
</div>

<div class="modal-overlay" id="universalModal" style="display: none;">
    <div class="modal">
        <h2 id="modalTitle">Título Dinâmico</h2>
        <p id="modalInstruction">Instrução Dinâmica</p>
        
        <div id="groupFolder" style="display: none;">
            <input id="nameFolder" placeholder="Nome da Pasta">
        </div>
        
        <div id="groupExFolder" style="display: none;">
            <input id="exFolderName" placeholder="Pasta que deseja excluir">
            <p> Confirme a pasta escrevendo novamente seu nome </p>
            <input id="exFolderConfirm" placeholder="Confirme a pasta que deseja excluir">
        </div>

        <div id="groupCard" style="display: none;">
            <input id="cardBank" placeholder="Nome do Banco">
            <p> Atribua um nome ao cartão </p>
            <input id="cardName" placeholder="Nome/Apelido do cartão">
            <p>Insira a data de fechamento do cartão</p>
            <input type="number" id="closeDate">

            <p>Insira a data de vencimento do cartão</p>
            <input type="number" id="endDate">
        </div>

        <div id="groupPurchase" style="display: none;" >
            <input id="phDescription" placeholder="Nome da compra">
            <p> Insira o valor da conta </p>
            <input id="price" type="tel" value="R$ 0,00" placeholder="R$ 0,00">            
            <p> Insira a quantidade de parcelas </p>
            <input id="installmentQuantity" type="number" placeholder="Quantidade de parcelas">
            
            <p>Atribuir à pasta:</p>
            <select id="phFolder" class="modal-select">
                <option value="">Nenhuma (Geral)</option>
                <% if (typeof pastas !== 'undefined') { %>
                    <% pastas.forEach(pasta => { %>
                        <option value="<%= pasta.id %>"><%= pasta.name %></option>
                        <% }) %>
                        <% } %>
                    </select>

            <p>Cartão utilizado:</p>
            <select id="phCard" class="modal-select">
                <option value="">Nenhum</option>
                <% if (typeof cards !== 'undefined') { %>
                    <% cards.forEach(cards => { %>
                        <option value="<%= cards.id %>"><%= cards.card_name %> (<%= cards.bank %>)</option>
                        <% }) %>
                        <% } %>
                    </select>
        </div>

        <div id="groupInstallments" style="display: none;">
            <div class="table-container" style="max-height: 250px; overflow-y: auto; margin-top: 15px;">
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr>
                            <th style="padding: 8px; border-bottom: 1px solid #444;">Produto</th>
                            <th style="padding: 8px; border-bottom: 1px solid #444;">Total</th>
                            <th style="padding: 8px; border-bottom: 1px solid #444;">Parcela</th>
                            <th style="padding: 8px; border-bottom: 1px solid #444;">Progresso</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% const comprasParceladas = (typeof itens !== 'undefined') ? itens.filter(g => g.total_installment > 1) : []; %>
                        
                        <% if (comprasParceladas.length > 0) { %>
                            <% comprasParceladas.forEach(gasto => { %>
                                <tr>
                                    <td style="padding: 8px; border-bottom: 1px solid #333;"><%= gasto.description %></td>
                                    
                                    <td style="padding: 8px; border-bottom: 1px solid #333;">R$ <%= Number(gasto.amount).toFixed(2).replace('.', ',') %></td>
                                    
                                    <td style="padding: 8px; border-bottom: 1px solid #333; color: #8b5cf6;">R$ <%= Number(gasto.valor_parcela_calculado).toFixed(2).replace('.', ',') %></td>
                                    
                                    <td style="padding: 8px; border-bottom: 1px solid #333;"><%= gasto.current_installment %> / <%= gasto.total_installment %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 15px; color: #888;">
                                    Você não possui nenhuma compra parcelada.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-buttons">
            <button id="cancelModal" class="cancel" onclick="closeModal()"> Cancelar </button>
            <button id="confirmBtn" class="add"> Confirmar </button>
        </div>
    </div>
</div>

<script src="/js/dashboardScript.js"></script>
</body>
</html>